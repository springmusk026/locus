<resources>
    <style name="Theme.Locus" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
    <!-- The automation confirmation (AutomationActivity): only its sheet shows, over the app that asked. -->
