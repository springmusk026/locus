<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted so people can use model servers on their own network (Ollama, LM Studio,
     llama.cpp) over http://. The provider editor warns when http:// points at a public address. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
