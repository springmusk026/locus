{
  "turns": [
    {
      "calls": [
        {
          "tool": "search_files",
          "args": {
            "pattern": "debug"
          }
        }
      ]
    },
    {
      "calls": [
        {
          "tool": "read_file",
          "args": {
            "path": "sites/blog/config.toml"
          }
        },
        {
          "tool": "read_file",
          "args": {
            "path": "sites/shop/config.toml"
          }
        },
        {
          "tool": "read_file",
          "args": {
            "path": "sites/docs/config.toml"
          }
        }
      ]
    },
    {
      "calls": [
        {
          "tool": "ask_user",
          "args": {
            "question": "There are three site configs with debug on (blog, shop, docs). Which one do you mean?",
            "options": [
              "blog",
              "shop",
              "docs",
              "all three"
            ]
          }
        }
      ]
    },
    {
      "calls": [
        {
          "tool": "edit_file",
          "args": {
            "path": "sites/blog/config.toml",
            "old_text": "debug = true",
            "new_text": "debug = false"
          }
        }
      ]
    },
    {
      "text": "Done."
    }
  ]
}
