            "content": "\"\"\"Money helpers. Amounts are integers in cents.\"\"\"\n\nSYMBOLS = {\"EUR\": \"€\", \"USD\": \"$\", \"GBP\": \"£\"}\n\n\ndef format_amount(cents, currency=None):\n    \"\"\"Format an amount in cents in a currency (ISO code): (1250, 'EUR') -> '€12.50', (123456, 'USD') -> '$1,234.56'.\"\"\"\n    if currency is None:\n        raise ValueError(\"currency is required\")\n    if currency not in SYMBOLS:\n        raise ValueError(f\"unknown currency: {currency}\")\n    return \"{}{:,.2f}\".format(SYMBOLS[currency], cents / 100)\n\n\ndef parse_amount(text):\n    \"\"\"'12.50', '€12.50' or '1,234.56' -> cents.\"\"\"\n    cleaned = text.strip().lstrip(\"€$£\").replace(\",\", \"\")\n    return round(float(cleaned) * 100)\n"
