<?xml version="1.0" encoding="UTF-8"?>
<!-- Android lint settings for every Android module (build-logic's configureKotlinAndroid points lint here). -->
<lint>
    <!-- Localisation (docs/design/localization.md): every string in values/ needs its es, pt and
         b+zh+Hans translation (or translatable="false"), and no translation may outlive its English key. -->
    <issue id="MissingTranslation" severity="error" />
    <issue id="ExtraTranslation" severity="error" />
</lint>
