    <string name="ui_catalog_integration_vercel_summary">部署、日志和变量</string>
    <string name="ui_catalog_integration_vercel_description">部署工作区文件夹，查看构建、日志和环境变量。部署和变量更改会先询问。请选择最小的范围（某个团队的 All Projects，或单个项目）。代表团队操作的 Full Account 令牌还需要加一个空格和团队 ID（team_…）。</string>
    <string name="ui_catalog_integration_netlify_summary">静态网站部署和变量</string>
    <string name="ui_catalog_integration_netlify_description">发布工作区中的静态文件夹，查看部署并管理环境变量。部署和变量更改会先询问。Netlify 允许每分钟 3 次、每天 100 次 API 部署。</string>
    <string name="ui_catalog_integration_cloudflare_summary">DNS、Pages 和 workers.dev 网站</string>
    <string name="ui_catalog_integration_cloudflare_description">管理 DNS 记录，查看或启动 Cloudflare Pages 部署，并将工作区文件夹发布为 workers.dev 网站。更改会先询问。请为你的域名创建一个自定义 API 令牌，包含 Zone → DNS → Edit（以及 Zone → Zone → Read）；如果使用 Pages，再加 Account → Cloudflare Pages → Edit；要发布网站，再加 Account → Workers Scripts → Edit。如果令牌能看到多个账户，请加一个空格和账户 ID。</string>
    <string name="ui_catalog_integration_supabase_summary">项目、SQL 和 Edge Functions</string>
    <string name="ui_catalog_integration_supabase_description">查看项目，用只读 SQL 读取数据，执行更改并部署 Edge Functions（这些操作总会先询问）。请创建一个仅限你的项目的令牌，包含 Projects → Read 和 Database → Read；要做更改再加 Database → Read-write，以及 Edge Functions → Read（部署需 Read-write），可选 API Keys → Read 和 Branches → Read。密钥的值永远不会给 AI 看到。</string>
    <string name="ui_catalog_integration_render_summary">服务、部署和日志</string>
    <string name="ui_catalog_integration_render_description">查看服务、部署和日志，启动部署，设置环境变量，暂停或恢复服务。部署、暂停和恢复总会询问；变量更改会询问。请在 Account Settings → API Keys 下创建密钥；它拥有你账户的权限（Render 的限定范围密钥尚处于抢先体验阶段）。变量的值永远不会给 AI 看到。</string>
    <string name="ui_catalog_integration_ntfy_key_help">例如 https://ntfy.sh/a-long-secret-name。如果该主题需要令牌，请加一个空格和 tk_ 令牌。</string>
