    <!-- Telegram sheet (TelegramSheet.kt). -->
    <string name="ui_telegram_subtitle">Notifications and scheduled task results from your own bot.</string>
    <!-- Three steps, one per line. \u2060 is a word joiner, so the command /newbot never breaks after the slash. -->
    <string name="ui_telegram_steps">1. In Telegram, open @BotFather, send /\u2060newbot and copy the token it gives you.\n2. Open your new bot and press Start (or send it any message).\n3. Paste the token here and tap Find my chat.</string>
    <string name="ui_telegram_bot_token">Bot token</string>
    <string name="ui_telegram_token_keep">Leave blank to keep the saved one</string>
    <!-- %1$s is the bot's @name, or "your bot" (the next string). -->
    <string name="ui_telegram_no_messages">No messages yet. Open %1$s in Telegram, press Start, then tap Find my chat again.</string>
    <string name="ui_telegram_your_bot">your bot</string>
    <string name="ui_telegram_find_chat">Find my chat</string>
    <!-- %1$s is the bot's username. -->
    <string name="ui_telegram_open_bot">Open @%1$s</string>
    <!-- A chat in the list: %1$s is its name, %2$s its kind ("private chat", or Telegram's own word). -->
    <string name="ui_telegram_chat_line">%1$s · %2$s</string>
    <string name="ui_telegram_chat_private">private chat</string>
    <string name="ui_telegram_chat_id">Chat ID</string>
    <string name="ui_telegram_group_warning">This is a group or channel: everyone in it will see your notifications.</string>
    <string name="ui_telegram_send_test">Send a test</string>
    <string name="ui_telegram_test_sent">Sent. Check Telegram.</string>
    <string name="ui_telegram_token_note">The token is stored encrypted on this phone and the AI never sees it. Locus only calls Telegram to send you something; it reads what you send the bot only once here, to find your chat, and while the remote options below are on.</string>
    <string name="ui_telegram_remove_title">Remove Telegram?</string>
    <string name="ui_telegram_remove_message">The bot token and chat are deleted from this phone. Notifications and scheduled task results stop going to Telegram.</string>
    <string name="ui_telegram_remote_title">Remote</string>
    <string name="ui_telegram_remote_private_only">Approving and sending tasks from Telegram need a private chat with your bot, so only your account can press a button.</string>
    <string name="ui_telegram_approve_title">Approve from Telegram</string>
    <string name="ui_telegram_approve_subtitle">Allow and Deny buttons come to this chat when a task working in the background asks.</string>
    <string name="ui_telegram_mode_title">Remote mode</string>
    <!-- %1$s is a time of day. -->
    <string name="ui_telegram_mode_on_until">On until %1$s. Messages to the bot start tasks in a chat called Telegram, or join the one running.</string>
    <string name="ui_telegram_mode_off_subtitle">Messages to the bot start tasks in a chat called Telegram. It switches itself off after the time below.</string>
    <string name="ui_telegram_widened_title">Let Telegram tasks do more than read</string>
    <string name="ui_telegram_widened_on">Telegram tasks run like a chat, asking before they change anything.</string>
    <string name="ui_telegram_widened_off">Off: they can look things up, read and answer, but can\'t change files, run commands or send anything.</string>
    <!-- How long remote mode stays on: %1$d minutes, or %1$d hours. -->
    <string name="ui_telegram_duration_minutes">%1$d min</string>
    <string name="ui_telegram_duration_hours">%1$d h</string>
    <!-- Description of a duration chip; %1$s is the chip's text. -->
    <string name="ui_telegram_mode_for">Remote mode for %1$s</string>
    <string name="ui_telegram_remote_note">Anything the safety reviewer flagged, or that must be confirmed (payments, sending, after reading outside content), still needs a tap in Locus; Telegram only says so. While remote mode is on, a notification shows and Locus keeps a connection to Telegram open, which uses some battery. Send /off to the bot to stop it from anywhere.</string>
    <string name="ui_telegram_widened_warning">Anyone who gets into your Telegram account can ask too, and plain approvals can be answered from the same chat. A bot chat isn\'t proof it\'s you, so off is the safe default.</string>
    <string name="ui_telegram_untrusted_note">Messages from Telegram are treated as outside content, never as your own words, and only this chat counts. Locus ignores messages sent before remote mode was on, and more than a few a minute.</string>

