<?xml version="1.0" encoding="utf-8"?>
<!-- Text of the rendered Markdown extras: diagrams and artifact previews (docs/design/localization.md).
     Keys are markdown_<part>_<element>; shared words are common_* in core/designsystem. -->
<resources>
    <!-- Mermaid diagram card (MermaidDiagram.kt). The name of the tool is not translated. -->
    <string name="markdown_mermaid_label" translatable="false">Mermaid</string>
    <string name="markdown_mermaid_diagram">Diagram</string>
    <string name="markdown_mermaid_source">Source</string>
    <string name="markdown_mermaid_drawing">Drawing diagram…</string>
    <string name="markdown_mermaid_zoom_hint">Diagram. Tap to zoom.</string>
    <string name="markdown_mermaid_copy">Copy diagram source</string>

    <!-- Artifact preview card (ArtifactCard.kt). -->
    <!-- The card's title when the artifact has none: %1$s is its format, HTML or SVG. -->
    <string name="markdown_artifact_preview_title">%1$s preview</string>
    <plurals name="markdown_artifact_requests_blocked">
        <item quantity="one">%1$d request blocked</item>
        <item quantity="other">%1$d requests blocked</item>
    </plurals>
    <!-- %1$s is the artifact's size and %2$s the limit, each with its unit (12 KB). -->
    <string name="markdown_artifact_too_large">Too large to preview (%1$s; the limit is %2$s).</string>
    <string name="markdown_artifact_view_source">View source</string>
    <string name="markdown_artifact_show_preview">Show the preview</string>
    <string name="markdown_artifact_stopped_tap">The preview stopped. Tap to run it again.</string>
    <string name="markdown_artifact_stopped">The preview stopped.</string>
    <string name="markdown_artifact_run">Run the preview</string>
    <string name="markdown_artifact_tap_run">Tap to run the preview</string>
    <string name="markdown_artifact_interact">Interact with the preview</string>
    <string name="markdown_artifact_tap_interact">Tap to interact</string>
    <!-- %1$s is the artifact's title, or "the preview" (the next string). -->
    <string name="markdown_artifact_snapshot">Snapshot of %1$s</string>
    <string name="markdown_artifact_the_preview">the preview</string>
    <string name="markdown_artifact_full_screen">Open full screen</string>
    <string name="markdown_artifact_save">Save to workspace</string>
    <!-- %1$s is the path it was saved to. -->
    <string name="markdown_artifact_saved">Saved to the workspace as %1$s</string>
    <string name="markdown_artifact_save_failed">Couldn\'t save to the workspace.</string>
    <string name="markdown_artifact_share_image">Share as image</string>
    <string name="markdown_artifact_run_first">Run the preview first.</string>
    <string name="markdown_artifact_sandboxed">Sandboxed · no network</string>
    <string name="markdown_artifact_open_elsewhere">Open in another app</string>
    <string name="markdown_artifact_browser_title">Open in browser?</string>
    <!-- %1$s is the address; it starts a new line. -->
    <string name="markdown_artifact_browser_message">The preview links to:\n%1$s</string>
    <string name="markdown_artifact_no_browser">No browser here can open it.</string>
    <!-- What the sandbox kept out (ArtifactSandbox.blockedNoticeRes). -->
    <string name="markdown_artifact_blocked_styles_scripts">Styles and scripts from the web are blocked here</string>
    <string name="markdown_artifact_blocked_styles">Styles from the web are blocked here</string>
    <string name="markdown_artifact_blocked_scripts">Scripts from the web are blocked here</string>
    <string name="markdown_artifact_blocked_other">Images and fonts from the web are blocked here</string>

    <!-- A size: %1$s is a number, written in the app's language, in bytes, kilobytes or megabytes. Units are not translated. -->
    <string name="markdown_size_bytes" translatable="false">%1$s B</string>
    <string name="markdown_size_kb" translatable="false">%1$s KB</string>
    <string name="markdown_size_mb" translatable="false">%1$s MB</string>
</resources>
