<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The opt-in update check hands a verified GitHub release APK to Android's installer, which still
         asks the user; Android also asks once whether Locus may install apps (docs/design/updates.md). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 17 (API 37): reaching LAN hosts (Ollama, LM Studio, SSH machines, MCP servers on
         private addresses) needs this runtime permission; Locus asks when such a target is added
         or used. developer.android.com/privacy-and-security/local-network-permission -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Whether the default network is metered, for Battery & heat (AndroidDeviceConditions). A normal
         permission; WorkManager declares it too. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- calendar_read reads upcoming events, asked for the first time the agent uses it
         (docs/design/android-bridge.md). Contacts and photos come from system pickers, with no permission. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- calendar_create / calendar_update / calendar_delete write to the one calendar the user picks in
         Settings → Phone; asked (with READ_CALENDAR, after Locus's own explanation) the first time one is
         used (docs/design/phone-integrations.md). -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- remind_me: Android clears alarms on reboot, so Locus sets its reminders again after one. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- remind_me on time to the minute, only if the user grants "Alarms & reminders" (denied by default on
         Android 14+); otherwise reminders use a 10-minute window. Not USE_EXACT_ALARM, which Play reserves
         for alarm-clock and calendar apps. developer.android.com/develop/background-work/services/alarms -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Lets the "Locus is working" notification be a Live Update on Android 16+. Not a runtime
         permission (no prompt); the user can turn Live Updates off for Locus in its notification settings. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Lets device_alarm / device_timer hand an alarm to the Clock app (a normal permission). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- device_open_app opens installed apps by name, so it needs to see launchable apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- Linux installs (LinuxSetupWorker) run as a WorkManager foreground job, like model downloads
             in core/ondevice, which declares the same; docs/design/linux-setup.md. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <service
            android:name=".agent.AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs an AI agent task the user started (reading and editing files in the app's workspace, calling the user's chosen model API) and shows approval prompts until the task finishes or the user stops it." />
        </service>

        <service
            android:name=".integrations.TelegramRemoteService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Telegram remote mode, which the user turns on for a limited time: waits for the user's messages to their own Telegram bot (long polling) and starts the tasks they send, with a persistent notification and a Turn off button." />
        </service>

        <receiver
            android:name=".agent.ApprovalReceiver"
            android:exported="false" />

        <receiver
            android:name=".agent.QuestionReceiver"
            android:exported="false" />

        <receiver
            android:name=".agent.BudgetReceiver"
            android:exported="false" />

        <!-- Reminder alarms, Snooze and Done, and setting the alarms again after a reboot, an update or an
             exact-alarm grant (docs/design/phone-integrations.md). Not exported: system broadcasts still arrive. -->
        <receiver
            android:name=".device.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Android's installer reports an update session's outcome here (docs/design/updates.md). -->
        <receiver
            android:name=".updates.UpdateInstallReceiver"
            android:exported="false" />

        <provider
            android:name=".provider.WorkspaceDocumentsProvider"
            android:authorities="${applicationId}.workspace"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
