<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 (API 37): reaching LAN hosts (Ollama, LM Studio, SSH machines, MCP servers on
         private addresses) needs this runtime permission; Locus asks when such a target is added
         or used. developer.android.com/privacy-and-security/local-network-permission -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the "Locus is working" notification be a Live Update on Android 16+. Not a runtime
         permission (no prompt); the user can turn Live Updates off for Locus in its notification settings. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Lets device_alarm / device_timer hand an alarm to the Clock app (a normal permission). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- device_open_app opens installed apps by name, so it needs to see launchable apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <service
            android:name=".agent.AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs an AI agent task the user started (reading and editing files in the app's workspace, calling the user's chosen model API) and shows approval prompts until the task finishes or the user stops it." />
        </service>

        <receiver
            android:name=".agent.ApprovalReceiver"
            android:exported="false" />

        <receiver
            android:name=".agent.QuestionReceiver"
            android:exported="false" />

        <provider
            android:name=".provider.WorkspaceDocumentsProvider"
            android:authorities="${applicationId}.workspace"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
