    <string name="onboarding_intro_title">Seu agente, no seu telefone</string>
    <string name="onboarding_intro_body">O Locus é um agente de IA que trabalha para você: lê, escreve, navega e executa código para resolver as coisas.</string>
    <string name="onboarding_intro_local_title">Roda aqui</string>
    <string name="onboarding_intro_local_body">O agente, suas ferramentas, seus arquivos e sua memória ficam neste telefone.</string>
    <string name="onboarding_intro_keys_title">Suas chaves</string>
    <string name="onboarding_intro_keys_body">Use uma chave do provedor de IA que você escolher, ou rode um modelo no próprio telefone. Sem conta do Locus.</string>
    <string name="onboarding_intro_control_title">Você decide</string>
    <string name="onboarding_intro_control_body">Cada ação passa pelas suas regras de aprovação, e tudo o que ele faz fica registrado.</string>
    <string name="onboarding_intro_footer">A configuração leva alguns minutos. Tudo depois da etapa do modelo é opcional e pode ser alterado depois em Configurações.</string>
    <string name="onboarding_privacy_title">O que sai do seu telefone</string>
    <string name="onboarding_privacy_body">O Locus não tem servidores. Veja exatamente para onde vão seus dados.</string>
    <string name="onboarding_privacy_provider_title">Direto ao seu provedor</string>
    <string name="onboarding_privacy_provider_body">Suas mensagens e os arquivos que o agente lê vão diretamente ao provedor de IA que você escolher, sob os termos desse provedor. Com o modelo no dispositivo, nada sai do aparelho.</string>
    <string name="onboarding_privacy_keys_title">As chaves ficam criptografadas</string>
    <string name="onboarding_privacy_keys_body">Chaves de API e senhas ficam em um cofre criptografado neste telefone e nunca são mostradas ao modelo.</string>
    <string name="onboarding_privacy_network_title">Só para onde você indicar</string>
    <string name="onboarding_privacy_network_body">Sites, serviços e máquinas só são contatados quando você, ou o agente com sua aprovação, os usa.</string>
    <string name="onboarding_privacy_updates_title">Verificar novas versões no GitHub?</string>
    <string name="onboarding_privacy_updates_body">Cerca de uma vez por dia, no Wi-Fi, uma requisição ao GitHub sem nada sobre você. Você decide se quer instalar; isso ignora as verificações das lojas de apps. Altere em Configurações → Sobre e privacidade.</string>
    <string name="onboarding_privacy_approvals_label">Aprovações</string>
    <string name="onboarding_privacy_allow_title">Permitir</string>
    <string name="onboarding_privacy_allow_body">Roda sem perguntar.</string>
    <string name="onboarding_privacy_ask_title">Perguntar</string>
    <string name="onboarding_privacy_ask_body">Espera você aprovar a cada vez, no app ou por uma notificação.</string>
    <string name="onboarding_privacy_deny_title">Negar</string>
    <string name="onboarding_privacy_deny_body">Nunca roda.</string>
    <string name="onboarding_privacy_profile_label">Ponto de partida</string>
    <string name="onboarding_privacy_profile_note">Você pode alterar qualquer ferramenta depois em Configurações → Permissões.</string>
    <string name="onboarding_privacy_consent">Entendo que o que peço ao Locus é enviado ao provedor de IA que escolho, e que o agente age dentro das aprovações acima.</string>
    <string name="onboarding_profile_careful_title">Cuidadoso</string>
    <string name="onboarding_profile_careful_summary">Pergunta antes de gravar, executar um comando ou ir para a internet. Só a leitura do espaço de trabalho e da memória acontece sozinha.</string>
    <string name="onboarding_profile_balanced_title">Equilibrado</string>
    <string name="onboarding_profile_balanced_summary">Os padrões. Pesquisar e ler páginas acontece sozinho; gravar arquivos, executar comandos e enviar qualquer coisa perguntam antes.</string>
    <string name="onboarding_profile_autonomous_title">Autônomo</string>
    <string name="onboarding_profile_autonomous_summary">Executa quase tudo sem perguntar. Pagamentos, logins, cliques sensíveis e máquinas remotas (SSH) continuam perguntando, e arquivos excluídos vão para a lixeira.</string>
    <string name="onboarding_provider_title">Escolha um modelo</string>
    <string name="onboarding_provider_body">O Locus conversa com o modelo de IA que você escolher, com sua própria chave. Ou rode o Gemma neste telefone, offline.</string>
    <string name="onboarding_provider_your_models">Seus modelos</string>
