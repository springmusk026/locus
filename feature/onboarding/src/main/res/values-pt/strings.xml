    <string name="onboarding_provider_default">Padrão</string>
    <string name="onboarding_provider_quick_start_note">Isso é tudo de que o Locus precisa. O início rápido abre a Página inicial agora; dar nome ao agente, Linux, máquinas SSH e conectores ficam lá como cartões que você pode concluir ou dispensar. Continuar a configuração completa passa por eles agora.</string>
