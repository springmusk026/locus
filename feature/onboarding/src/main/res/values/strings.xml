    <!-- Welcome -->
    <string name="onboarding_intro_title">Your agent, on your phone</string>
    <string name="onboarding_intro_body">Locus is an AI agent that works for you: it reads, writes, browses and runs code to get things done.</string>
    <string name="onboarding_intro_local_title">Runs here</string>
    <string name="onboarding_intro_local_body">The agent, its tools, your files and its memory all live on this phone.</string>
    <string name="onboarding_intro_keys_title">Your keys</string>
    <string name="onboarding_intro_keys_body">Bring a key from the AI provider you choose, or run a model on the phone itself. No Locus account.</string>
    <string name="onboarding_intro_control_title">You decide</string>
    <string name="onboarding_intro_control_body">Every action goes through your approval rules, and everything it does is logged.</string>
    <string name="onboarding_intro_footer">Setup takes a few minutes. Everything after the model step is optional and can be changed later in Settings.</string>

    <!-- Privacy -->
    <string name="onboarding_privacy_title">What leaves your phone</string>
    <string name="onboarding_privacy_body">Locus has no servers. Here is exactly where your data goes.</string>
    <string name="onboarding_privacy_provider_title">Straight to your provider</string>
    <string name="onboarding_privacy_provider_body">Your messages and the files the agent reads go directly to the AI provider you pick, under that provider\'s terms. With the on-device model, nothing leaves at all.</string>
    <string name="onboarding_privacy_keys_title">Keys stay encrypted</string>
    <string name="onboarding_privacy_keys_body">API keys and passwords are kept in an encrypted vault on this phone, never shown to the model.</string>
    <string name="onboarding_privacy_network_title">Only where you point it</string>
    <string name="onboarding_privacy_network_body">Websites, services and machines are contacted only when you, or the agent with your approval, use them.</string>
    <string name="onboarding_privacy_updates_title">Check GitHub for new versions?</string>
    <string name="onboarding_privacy_updates_body">About once a day on Wi-Fi, one request to GitHub with nothing about you. You decide whether to install; this bypasses app-store checks. Change it in Settings → About &amp; privacy.</string>
    <string name="onboarding_privacy_approvals_label">Approvals</string>
    <string name="onboarding_privacy_allow_title">Allow</string>
    <string name="onboarding_privacy_allow_body">Runs without asking.</string>
    <string name="onboarding_privacy_ask_title">Ask</string>
    <string name="onboarding_privacy_ask_body">Waits for you to approve each time, in the app or from a notification.</string>
    <string name="onboarding_privacy_deny_title">Deny</string>
    <string name="onboarding_privacy_deny_body">Never runs.</string>
    <string name="onboarding_privacy_profile_label">Starting point</string>
    <string name="onboarding_privacy_profile_note">You can change any single tool later in Settings → Permissions.</string>
    <string name="onboarding_privacy_consent">I understand that what I ask Locus to work on is sent to the AI provider I choose, and that the agent acts within the approvals above.</string>

    <!-- Permission profiles -->
    <string name="onboarding_profile_careful_title">Careful</string>
    <string name="onboarding_profile_careful_summary">Asks before anything that writes, runs a command or goes online. Only reading your workspace and memory happens on its own.</string>
    <string name="onboarding_profile_balanced_title">Balanced</string>
    <string name="onboarding_profile_balanced_summary">The defaults. Looking things up and reading pages run on their own; writing files, running commands and sending anything ask first.</string>
    <string name="onboarding_profile_autonomous_title">Autonomous</string>
    <string name="onboarding_profile_autonomous_summary">Runs almost everything without asking. Payments, logins, sensitive clicks and remote machines (SSH) still ask, and deleted files go to the trash.</string>

