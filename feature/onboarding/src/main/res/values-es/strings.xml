    <string name="onboarding_intro_title">Tu agente, en tu teléfono</string>
    <string name="onboarding_intro_body">Locus es un agente de IA que trabaja para ti: lee, escribe, navega y ejecuta código para hacer las cosas.</string>
    <string name="onboarding_intro_local_title">Funciona aquí</string>
    <string name="onboarding_intro_local_body">El agente, sus herramientas, tus archivos y su memoria viven en este teléfono.</string>
    <string name="onboarding_intro_keys_title">Tus claves</string>
    <string name="onboarding_intro_keys_body">Usa una clave del proveedor de IA que elijas, o ejecuta un modelo en el propio teléfono. Sin cuenta de Locus.</string>
    <string name="onboarding_intro_control_title">Tú decides</string>
    <string name="onboarding_intro_control_body">Cada acción pasa por tus reglas de aprobación, y todo lo que hace queda registrado.</string>
    <string name="onboarding_intro_footer">La configuración toma unos minutos. Todo lo que sigue al paso del modelo es opcional y se puede cambiar luego en Ajustes.</string>
    <string name="onboarding_privacy_title">Qué sale de tu teléfono</string>
    <string name="onboarding_privacy_body">Locus no tiene servidores. Aquí está exactamente a dónde van tus datos.</string>
    <string name="onboarding_privacy_provider_title">Directo a tu proveedor</string>
    <string name="onboarding_privacy_provider_body">Tus mensajes y los archivos que lee el agente van directamente al proveedor de IA que elijas, según los términos de ese proveedor. Con el modelo en el dispositivo, no sale nada.</string>
    <string name="onboarding_privacy_keys_title">Las claves siguen cifradas</string>
    <string name="onboarding_privacy_keys_body">Las claves de API y las contraseñas se guardan en una bóveda cifrada en este teléfono y nunca se muestran al modelo.</string>
    <string name="onboarding_privacy_network_title">Solo adonde tú lo indiques</string>
    <string name="onboarding_privacy_network_body">Los sitios web, servicios y equipos solo se contactan cuando tú, o el agente con tu aprobación, los usan.</string>
    <string name="onboarding_privacy_updates_title">¿Buscar versiones nuevas en GitHub?</string>
    <string name="onboarding_privacy_updates_body">Una vez al día aproximadamente, con Wi-Fi, una solicitud a GitHub sin nada sobre ti. Tú decides si instalar; esto omite las comprobaciones de las tiendas de apps. Cámbialo en Ajustes → Acerca de y privacidad.</string>
    <string name="onboarding_privacy_approvals_label">Aprobaciones</string>
    <string name="onboarding_privacy_allow_title">Permitir</string>
    <string name="onboarding_privacy_allow_body">Se ejecuta sin preguntar.</string>
    <string name="onboarding_privacy_ask_title">Preguntar</string>
    <string name="onboarding_privacy_ask_body">Espera a que apruebes cada vez, en la app o desde una notificación.</string>
    <string name="onboarding_privacy_deny_title">Rechazar</string>
    <string name="onboarding_privacy_deny_body">Nunca se ejecuta.</string>
    <string name="onboarding_privacy_profile_label">Punto de partida</string>
    <string name="onboarding_privacy_profile_note">Puedes cambiar cualquier herramienta después en Ajustes → Permisos.</string>
    <string name="onboarding_privacy_consent">Entiendo que lo que le pido a Locus se envía al proveedor de IA que elijo, y que el agente actúa dentro de las aprobaciones indicadas arriba.</string>
    <string name="onboarding_profile_careful_title">Cauteloso</string>
    <string name="onboarding_profile_careful_summary">Pregunta antes de escribir, ejecutar un comando o conectarse a internet. Solo leer tu espacio de trabajo y la memoria ocurre sin preguntar.</string>
    <string name="onboarding_profile_balanced_title">Equilibrado</string>
    <string name="onboarding_profile_balanced_summary">Los valores predeterminados. Buscar información y leer páginas ocurre solo; escribir archivos, ejecutar comandos y enviar algo preguntan antes.</string>
    <string name="onboarding_profile_autonomous_title">Autónomo</string>
    <string name="onboarding_profile_autonomous_summary">Ejecuta casi todo sin preguntar. Los pagos, inicios de sesión, clics sensibles y equipos remotos (SSH) siguen preguntando, y los archivos eliminados van a la papelera.</string>
    <string name="onboarding_provider_title">Elige un modelo</string>
    <string name="onboarding_provider_body">Locus habla con el modelo de IA que elijas, con tu propia clave. O ejecuta Gemma en este teléfono, sin conexión.</string>
